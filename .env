# =========================
# DATABASE
# =========================
DB_URL=jdbc:mysql://localhost:3306/techcycle_system?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# =========================
# MAIL
# =========================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# =========================
# GOOGLE OAUTH2
# =========================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# =========================
# FACEBOOK OAUTH2
# =========================
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_REDIRECT_URI=http://localhost:8080/auth/facebook/callback

# =========================
# JWT
# =========================
JWT_SECRET=your_super_secret_jwt_key
JWT_ACCESS_TOKEN_EXPIRATION=9000000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# =========================
# REDIS
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =========================
# MINIO
# =========================
MINIO_ENABLED=true
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=12345678
MINIO_BUCKET_NAME=techcycle

# =========================
# FRONTEND
# =========================
FRONTEND_URL=http://localhost:5173
FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password

# =========================
# AUTH COOKIE
# =========================
REFRESH_COOKIE_SECURE=false